// P016 durable store declarations.
//
// CVARINFO is the only mechanism in the pinned engine by which a mod can
// declare an archived cvar. ZScript file scope cannot declare cvars at all.
// These default to CVAR_MOD|CVAR_ARCHIVE (see d_main.cpp ParseCVarInfo) and
// must name one of server/user/nosave.
//
// The values here are bounded diagnostic markers for the P016 investigation,
// not the production profile schema.

// These are profile-storage cvars, not networked game settings, so they are
// declared 'nosave' (CVAR_CONFIG_ONLY). 'server' would route writes through the
// serverinfo callback path, which is wrong for a local profile store.
nosave int ds_p016_marker = 0;
nosave String ds_p016_profile_id = "";
nosave String ds_p016_payload = "";
nosave int ds_p016_schema_version = 1;

