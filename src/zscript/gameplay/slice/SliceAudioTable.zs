    // hit sound of a weapon engine (N2CreditDamage engine names)
    static int ForHitEngine(String engine)
    {
        if (engine == "AIMED") return H_AIMED;
        if (engine == "BALLISTIC") return H_BALLISTIC;
        if (engine == "RETURNING") return H_RETURNING;
        if (engine == "ORBIT") return H_ORBIT;
        if (engine == "GROUND") return H_GROUND;
        if (engine == "AURA") return H_AURA;
        if (engine == "GLOBAL") return H_GLOBAL;
        if (engine == "BOUNCE") return H_BOUNCE;
        if (engine == "PAIRED") return H_PAIRED;
        if (engine == "GENERIC") return HIT;
        return HIT;
    }

    // death sound of an enemy family (DSStage.Family)
    static const int FAMILY_SFX[] = { 113, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112 };   // DEATH D_BAT D_ZOMBIE D_SKELETON D_GHOST D_MUDMAN D_BEAST D_INSECT D_MUMMY D_PLANT D_REAPER D_JELLY D_CASTER D_KNIGHT D_DRAGON D_FISH D_DEMON D_ANGEL D_OBJECT D_CRITTER D_BLOB
    const FAMILY_SFX_COUNT = 21;
    static int ForFamily(int family)
    {
        return family > 0 && family < FAMILY_SFX_COUNT ? DSSfx.FAMILY_SFX[family] : DEATH;
    }

    // pickup sound of a stage item (MF_ITEM_* kinds)
