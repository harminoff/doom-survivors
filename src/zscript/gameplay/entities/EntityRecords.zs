// Fixed-schema record names for the P020 run-save fixture.
struct DSP020SerializedEntity
{
    int stableId;
    int generation;
    int kind;
    int state;
    int health;
    int ownerSlot;
    int ownerGeneration;
    int ownerId;
    int targetSlot;
    int targetGeneration;
    int targetId;
    int damageTargetSlot;
    int dropOwnerSlot;
    int hitHistoryTargetSlot;
    int statusOwnerSlot;
    int timer;
    double logicalX;
    double logicalY;
}
